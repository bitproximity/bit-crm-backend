# Supabase (proyecto CRM Bit — separado del de los tenants)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Puerto (Railway lo inyecta automáticamente, esto es solo para local)
PORT=3000

# Origen permitido para CORS (tu frontend en Cloudflare Pages)
FRONTEND_ORIGIN=https://crm.bitproximity.com

# Integración Gmail — credenciales OAuth de Google Cloud Console
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret
GOOGLE_REDIRECT_URI=https://tu-backend.up.railway.app/api/gmail/callback

# Reporte financiero de solo lectura (/api/reporting). Si faltan, el proceso arranca
# igual y esas rutas responden 503. No uses el usuario postgres ni el service_role.
# Usuario del pooler: cfo_readonly.<project-ref>. La contraseña va codificada para URL.
# REPORTING_DATABASE_URL=postgresql://cfo_readonly.PROJECT_REF:PASSWORD@HOST_DEL_POOLER:6543/postgres?sslmode=require
# REPORTING_API_TOKEN=genera_uno_con_openssl_rand_-hex_32
